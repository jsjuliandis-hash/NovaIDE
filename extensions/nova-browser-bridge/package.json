{
  "name": "nova-browser-bridge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "nova-ide",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "enabledApiProposals": [
    "browser"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "novaBrowserBridge.selfTest",
        "title": "%command.selfTest%",
        "category": "Nova"
      },
      {
        "command": "novaBrowserBridge.configureCliAgents",
        "title": "%command.configureCliAgents%",
        "category": "Nova"
      },
      {
        "command": "novaBrowserBridge.copyToken",
        "title": "%command.copyToken%",
        "category": "Nova"
      },
      {
        "command": "novaBrowserBridge.showStatus",
        "title": "%command.showStatus%",
        "category": "Nova"
      },
      {
        "command": "novaBrowserBridge.devServer.start",
        "title": "%command.devServer.start%",
        "category": "Nova"
      },
      {
        "command": "novaBrowserBridge.devServer.stop",
        "title": "%command.devServer.stop%",
        "category": "Nova"
      },
      {
        "command": "novaBrowserBridge.devServer.restart",
        "title": "%command.devServer.restart%",
        "category": "Nova"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "nova.browserBridge.port": {
          "type": "number",
          "default": 47800,
          "description": "%config.port%"
        },
        "nova.browserBridge.cdpPort": {
          "type": "number",
          "default": 47801,
          "description": "%config.cdpPort%"
        },
        "nova.browserBridge.allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "localhost",
            "127.0.0.1",
            "[::1]",
            "0.0.0.0",
            "[::]"
          ],
          "markdownDescription": "%config.allowedHosts%"
        },
        "nova.browserBridge.allowExternalHosts": {
          "type": "boolean",
          "default": false,
          "description": "%config.allowExternalHosts%"
        },
        "nova.browserBridge.allowEvaluate": {
          "type": "boolean",
          "default": false,
          "description": "%config.allowEvaluate%"
        },
        "nova.devServer.autoStart": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "ask",
          "description": "%config.devServer.autoStart%"
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:nova-browser-bridge",
    "watch": "gulp watch-extension:nova-browser-bridge"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright-core": "^1.48.0",
    "ws": "^8.21.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/ws": "^8.18.1"
  }
}
