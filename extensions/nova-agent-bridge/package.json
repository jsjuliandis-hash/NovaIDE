{
  "name": "nova-agent-bridge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "nova-ide",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatSessionCustomizationProvider",
    "chatParticipantAdditions"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "contributes": {
    "chatSessions": [
      {
        "type": "nova-opencode",
        "name": "opencode",
        "displayName": "OpenCode",
        "description": "%chatSessions.opencode.description%",
        "icon": "$(nova-logo-opencode)",
        "welcomeTitle": "OpenCode",
        "welcomeMessage": "%chatSessions.opencode.welcomeMessage%",
        "inputPlaceholder": "%chatSessions.opencode.inputPlaceholder%",
        "order": 5,
        "canDelegate": true,
        "supportsAutoModel": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsPromptAttachments": true
        }
      },
      {
        "type": "nova-claude-code",
        "name": "claude-code",
        "displayName": "Claude Code",
        "description": "%chatSessions.claudeCode.description%",
        "icon": "$(nova-logo-claude-code)",
        "welcomeTitle": "Claude Code",
        "welcomeMessage": "%chatSessions.claudeCode.welcomeMessage%",
        "inputPlaceholder": "%chatSessions.claudeCode.inputPlaceholder%",
        "order": 6,
        "canDelegate": true,
        "supportsAutoModel": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsPromptAttachments": true
        }
      },
      {
        "type": "nova-codex",
        "name": "codex-cli",
        "displayName": "Codex CLI",
        "description": "%chatSessions.codex.description%",
        "icon": "$(nova-logo-codex)",
        "welcomeTitle": "Codex CLI",
        "welcomeMessage": "%chatSessions.codex.welcomeMessage%",
        "inputPlaceholder": "%chatSessions.codex.inputPlaceholder%",
        "order": 7,
        "canDelegate": true,
        "supportsAutoModel": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsPromptAttachments": true
        }
      },
      {
        "type": "nova-gemini",
        "name": "gemini-cli",
        "displayName": "Gemini CLI",
        "description": "%chatSessions.gemini.description%",
        "icon": "$(nova-logo-gemini-cli)",
        "welcomeTitle": "Gemini CLI",
        "welcomeMessage": "%chatSessions.gemini.welcomeMessage%",
        "inputPlaceholder": "%chatSessions.gemini.inputPlaceholder%",
        "order": 8,
        "canDelegate": true,
        "supportsAutoModel": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsPromptAttachments": true
        }
      },
      {
        "type": "nova-nvidia",
        "name": "nvidia",
        "displayName": "NVIDIA",
        "description": "%chatSessions.nvidia.description%",
        "icon": "$(nova-logo-nvidia)",
        "welcomeTitle": "NVIDIA",
        "welcomeMessage": "%chatSessions.nvidia.welcomeMessage%",
        "inputPlaceholder": "%chatSessions.nvidia.inputPlaceholder%",
        "order": 9,
        "canDelegate": true,
        "supportsAutoModel": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsPromptAttachments": true
        }
      },
      {
        "type": "nova-openrouter",
        "name": "openrouter",
        "displayName": "OpenRouter",
        "description": "%chatSessions.openrouter.description%",
        "icon": "$(nova-logo-openrouter)",
        "welcomeTitle": "OpenRouter",
        "welcomeMessage": "%chatSessions.openrouter.welcomeMessage%",
        "inputPlaceholder": "%chatSessions.openrouter.inputPlaceholder%",
        "order": 10,
        "canDelegate": true,
        "supportsAutoModel": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsPromptAttachments": true
        }
      }
    ],
    "commands": [
      {
        "command": "novaAgentBridge.showLog",
        "title": "%command.showLog%",
        "category": "Nova"
      },
      {
        "command": "novaAgentBridge.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Nova"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "nova.agents.injectIdeManual": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.injectIdeManual%"
        },
        "nova.agents.opencode.command": {
          "type": "string",
          "default": "opencode",
          "description": "%configuration.opencode.command%"
        },
        "nova.agents.opencode.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "acp"
          ],
          "description": "%configuration.opencode.args%"
        },
        "nova.agents.claudeCode.command": {
          "type": "string",
          "default": "npx",
          "description": "%configuration.claudeCode.command%"
        },
        "nova.agents.claudeCode.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-y",
            "@agentclientprotocol/claude-agent-acp"
          ],
          "description": "%configuration.claudeCode.args%"
        },
        "nova.agents.codex.command": {
          "type": "string",
          "default": "npx",
          "description": "%configuration.codex.command%"
        },
        "nova.agents.codex.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-y",
            "@agentclientprotocol/codex-acp"
          ],
          "description": "%configuration.codex.args%"
        },
        "nova.agents.gemini.command": {
          "type": "string",
          "default": "npx",
          "description": "%configuration.gemini.command%"
        },
        "nova.agents.gemini.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-y",
            "@google/gemini-cli",
            "--acp"
          ],
          "description": "%configuration.gemini.args%"
        },
        "nova.agents.openrouter.freeModelsOnly": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.openrouter.freeModelsOnly%"
        }
      }
    },
    "icons": {
      "nova-logo-ai2": {
        "description": "ai2 logo",
